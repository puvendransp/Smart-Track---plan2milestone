                  {ms.title}
                </h3>
                {ms.description && (
                  <p className="text-[11px] text-slate-400 line-clamp-1 mt-0.5">{ms.description}</p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};
